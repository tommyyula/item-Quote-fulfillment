{
  "name": "unis-quote",
  "private": true,
  "version": "0.2.0",
  "description": "UNIS quotation tool: API (server/, bundled into a Vercel Function by scripts/build-vercel.mjs) + web app (web/)",
  "scripts": {
    "dev:api": "tsx watch server/dev.mts",
    "test": "vitest run --dir server",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.mts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.9.9",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
